{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "checks",
  "description": "Proof checks written by the test run (tests/conftest.py).",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "seed": {
      "type": "integer"
    },
    "source": {
      "type": "string"
    },
    "data_provenance": {
      "const": "synthetic"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          },
          "area": {
            "enum": [
              "quantum",
              "classical",
              "ui",
              "shared"
            ]
          },
          "test": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "passed",
          "detail",
          "area",
          "test"
        ]
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer"
        },
        "passed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        }
      },
      "required": [
        "total",
        "passed",
        "failed"
      ]
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "seed",
    "source",
    "data_provenance",
    "checks",
    "summary"
  ]
}
