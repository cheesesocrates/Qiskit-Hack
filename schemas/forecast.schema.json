{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "forecast",
  "description": "Classical ridge-regression shortfall forecast. The demand series is synthetic.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "seed": {
      "type": "integer"
    },
    "source": {
      "type": "string"
    },
    "data_provenance": {
      "const": "synthetic"
    },
    "label": {
      "const": "classical"
    },
    "model": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "alpha": {
          "type": "number"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "n_train": {
          "type": "integer"
        },
        "n_test": {
          "type": "integer"
        }
      },
      "required": [
        "type",
        "alpha",
        "features",
        "n_train",
        "n_test"
      ]
    },
    "weather_source": {
      "enum": [
        "open-meteo-live",
        "open-meteo-snapshot",
        "synthetic-scenario-file"
      ]
    },
    "weather_provenance": {
      "enum": [
        "real",
        "synthetic"
      ]
    },
    "demand_provenance": {
      "const": "synthetic"
    },
    "location": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "mae_mw": {
          "type": "number"
        },
        "rmse_mw": {
          "type": "number"
        },
        "r2": {
          "type": "number"
        }
      },
      "required": [
        "mae_mw",
        "rmse_mw",
        "r2"
      ]
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string"
          },
          "hour": {
            "type": "integer"
          },
          "temperature_c": {
            "type": "number"
          },
          "shortfall_actual_mw": {
            "type": "number"
          },
          "shortfall_pred_mw": {
            "type": "number"
          },
          "split": {
            "enum": [
              "train",
              "test"
            ]
          }
        },
        "required": [
          "time",
          "hour",
          "temperature_c",
          "shortfall_actual_mw",
          "shortfall_pred_mw",
          "split"
        ]
      },
      "minItems": 1
    },
    "residuals": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer"
        },
        "std_mw": {
          "type": "number"
        },
        "bins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lo": {
                "type": "number"
              },
              "hi": {
                "type": "number"
              },
              "mid": {
                "type": "number"
              },
              "prob": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "lo",
              "hi",
              "mid",
              "prob"
            ]
          },
          "minItems": 2
        }
      },
      "required": [
        "n",
        "std_mw",
        "bins"
      ]
    },
    "day_ahead": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hour": {
            "type": "integer"
          },
          "shortfall_pred_mw": {
            "type": "number"
          },
          "quota": {
            "type": "integer"
          }
        },
        "required": [
          "hour",
          "shortfall_pred_mw",
          "quota"
        ]
      },
      "minItems": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "seed",
    "source",
    "data_provenance",
    "label",
    "model",
    "weather_source",
    "weather_provenance",
    "demand_provenance",
    "location",
    "metrics",
    "series",
    "residuals",
    "day_ahead",
    "notes"
  ]
}
